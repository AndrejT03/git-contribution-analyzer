# Copy this file to .env and fill in your real values.
# The .env file must be next to pom.xml.

# Git analysis limits
# MAX_COMMITS: Number between 1 and 200
MAX_COMMITS=80
# MAX_DIFF_CHARS: 500-20000 characters per commit diff
MAX_DIFF_CHARS=6000
# GIT_TIMEOUT_SECONDS: 20-600 seconds per Git command
GIT_TIMEOUT_SECONDS=120

# Gemini analysis
# Leave GEMINI_API_KEY empty to use the local fallback analyzer.
# Add a real key (from Google AI Studio) only to your local .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# GEMINI_TIMEOUT_SECONDS: 30-600
GEMINI_TIMEOUT_SECONDS=180

# Email delivery
# Keep MAIL_ENABLED=false if you only need the browser report.
# For Gmail, use an application password instead of the account password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
# MAIL_FROM may be left empty; MAIL_USERNAME is then used as the sender.
MAIL_FROM=your_email@gmail.com
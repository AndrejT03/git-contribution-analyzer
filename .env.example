# Copy this file to .env in the directory from which you start the application.
# Use Java properties syntax: KEY=value, without export or surrounding quotes.
# AI keys and models are supplied through the analysis form.

MAX_COMMITS=80
MAX_DIFF_CHARS=6000
GIT_TIMEOUT_SECONDS=120
AI_TIMEOUT_SECONDS=180

# Email delivery is enabled by default. Set false to disable it explicitly.
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
# For Gmail, use an app password, not your Google account password.
MAIL_PASSWORD=
# Optional: defaults to MAIL_USERNAME when empty.
MAIL_FROM=